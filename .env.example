# ── Gemini API ────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── LLM Provider Configuration ────────────────────────────────────────────────
# Choices: gemini, ollama
LLM_PROVIDER=gemini

# ── Ollama Settings (Optional if provider=ollama) ─────────────────────────────
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
